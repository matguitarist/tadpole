            "value" : "%lld mods"
          }
        }
      }
    },
    "%lld mods · %lld loaded" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld mods · %2$lld loaded"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld mods · %2$lld chargés"
          }
        }
      }
    },
    "%lld mods can't be checked: they aren't linked to Nexus. Select one in Load Order and click Find on Nexus… in its details." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mods ne peuvent pas être vérifiés : ils ne sont pas liés à Nexus. Sélectionnez-en un dans l’ordre de chargement et cliquez sur Trouver sur Nexus… dans ses détails."
          }
        }
      }
    },
    "%lld mods loaded" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mods chargés"
          }
        }
      }
    },
    "%lld mods need Norbyte's Script Extender, which only exists on Windows: on a Mac they install, but their scripted features don't work." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mods ont besoin du Script Extender de Norbyte, qui n’existe que sur Windows : sur Mac, ils s’installent, mais leurs fonctions scriptées ne marchent pas."
          }
        }
      }
    },
    "%lld mods need the Script Extender. It's installed, so they should work, as far as the macOS version supports them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mods ont besoin du Script Extender. Il est installé : ils devraient marcher, dans la mesure où la version macOS les prend en charge."
          }
        }
      }
    },
    "%lld new mods will be turned on when you quit the game." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld nouveaux mods seront activés quand vous quitterez le jeu."
          }
        }
      }
    },
    "%lld not installed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld non installés"
          }
        }
      }
    },
    "%lld of %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld sur %lld"
          }
        }
      }
    },
    "%lld requirement issues" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld problèmes de prérequis"
          }
        }
      }
    },
    "%lld saves" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld sauvegardes"
          }
        }
      }
    },
    "%lld script errors in your last game." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld erreurs de script pendant votre dernière partie."
          }
        }
      }
    },
    "%lld Script Extender errors in your last game" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld erreurs du Script Extender pendant votre dernière partie"
          }
        }
      }
    },
    "%lld updates available…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mises à jour disponibles…"
          }
        }
      }
    },
    "1 mod" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 mod"
          }
        }
      }
    },
    "1 mod loaded" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 mod chargé"
          }
        }
      }
    },
    "1 mod needs Norbyte's Script Extender, which only exists on Windows: on a Mac it installs, but its scripted features don't work." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 mod a besoin du Script Extender de Norbyte, qui n’existe que sur Windows : sur Mac, il s’installe, mais ses fonctions scriptées ne marchent pas."
          }
        }
      }
    },
    "1 mod needs the Script Extender. It's installed, so it should work, as far as the macOS version supports it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 mod a besoin du Script Extender. Il est installé : il devrait marcher, dans la mesure où la version macOS le prend en charge."
          }
        }
      }
    },
    "1 not installed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 non installé"
          }
        }
      }
    },
    "1 requirement issue" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 problème de prérequis"
          }
        }
      }
    },
    "1 script error in your last game." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 erreur de script pendant votre dernière partie."
          }
        }
      }
    },
    "1 Script Extender error in your last game" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 erreur du Script Extender pendant votre dernière partie"
          }
        }
      }
    },
    "1 update available…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 mise à jour disponible…"
          }
        }
      }
    },
    "A copy of the load order now. Changes you make next are kept in the new profile." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie de l’ordre de chargement actuel. Les changements suivants sont gardés dans le nouveau profil."
          }
        }
      }
    },
    "A crash report was saved. Open Tadpole to see it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport de plantage a été enregistré. Ouvrez Tadpole pour le voir."
          }
        }
      }
    },
    "A load order from BG3 Mod Manager, Tadpole, or a modsettings.lsx file." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ordre de chargement de BG3 Mod Manager, de Tadpole, ou un fichier modsettings.lsx."
          }
        }
      }
    },
    "A mod doesn't show up in the game" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mod n’apparaît pas dans le jeu"
          }
        }
      }
    },
    "A mod's window and details list what its Nexus page requires: a green check when you have it, **View** to open one you don't. When you install a mod that needs mods you don't have, Tadpole lists them, with the author's notes, so you can install them along. Untick the ones the notes say are optional." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre et les détails d’un mod listent ce que sa page Nexus exige : une coche verte quand vous l’avez, **Voir** pour ouvrir ceux qui manquent. Quand vous installez un mod qui a besoin de mods que vous n’avez pas, Tadpole les liste, avec les notes de l’auteur, pour les installer en même temps. Décochez ceux que les notes disent facultatifs."
          }
        }
      }
    },
    "A profile already has that name." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profil porte déjà ce nom."
          }
        }
      }
    },
    "A profile can list mods you don't have (after deleting one, or from a friend's list): they stay in it, and Tadpole tells you which when you switch. When you install a collection, tick **In a new profile** to give it its own." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profil peut lister des mods que vous n’avez pas (après en avoir supprimé un, ou d’après la liste d’un ami) : ils y restent, et Tadpole vous dit lesquels quand vous changez de profil. Quand vous installez une collection, cochez **Dans un nouveau profil** pour lui donner le sien."
          }
        }
      }
    },
    "A profile is a load order with a name: one per playthrough, one per collection… The menu at the top left of **Load Order** shows the profile in use; pick another to switch. Switching writes that profile's load order; the one you leave keeps yours, so switching back returns to exactly that list." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profil est un ordre de chargement avec un nom : un par partie, un par collection… Le menu en haut à gauche de **Ordre de chargement** affiche le profil utilisé ; choisissez-en un autre pour changer. Changer écrit l’ordre de chargement de ce profil ; celui que vous quittez garde le vôtre, donc revenir redonne exactement cette liste."
          }
        }
      }
    },
    "A save made with mods shows how many, in green when you have them all, orange when some are missing. Right-click → **Show Mods…** lists them, in the load order the save was made with; **Use This Save's Mods** makes a profile with exactly that load order and switches to it, so the save loads with the mods it needs." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde faite avec des mods indique combien, en vert quand vous les avez tous, en orange quand certains manquent. Clic droit → **Afficher les mods…** les liste, dans l’ordre de chargement de la sauvegarde ; **Utiliser les mods de cette sauvegarde** crée un profil avec exactement cet ordre de chargement et l’utilise, pour que la sauvegarde se charge avec les mods dont elle a besoin."
          }
        }
      }
    },
    "A Script Extender mod doesn't work" : {
