            "value" : "Utiliser les mods de cette sauvegarde"
          }
        }
      }
    },
    "Uses Norbyte's Script Extender, which isn't installed. Its scripted features won't work; parts that don't need it may still work. Install the macOS version in Settings → Script Extender." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
