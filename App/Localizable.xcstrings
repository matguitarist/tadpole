    "Add your Nexus API key to install mods from here": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre clé d’API Nexus pour installer des mods d’ici"
          }
        }
      }
    },
    "Add your personal Nexus Mods API key in Settings to download mods.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre clé d’API personnelle Nexus Mods dans les Réglages pour télécharger des mods."
