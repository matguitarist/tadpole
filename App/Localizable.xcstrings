    "Back up before trying new mods: a save made with a mod can need that mod to load.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une copie avant d’essayer de nouveaux mods : une sauvegarde faite avec un mod peut en avoir besoin pour se charger."
          }
        }
      }
    },
