            "value" : "Aucun résultat. Essayez un autre nom, ou collez le lien du mod ci-dessous."
          }
        }
      }
    },
    "No mod description inside: the game always loads these. Move one to the Trash to stop it." : {
      "localizations" : {
        "fr" : {
