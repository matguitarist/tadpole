            "value" : "Taille"
          }
        }
      }
    },
    "Skip" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer"
          }
        }
      }
    },
    "Skip Script Extender mods" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorer les mods Script Extender"
          }
        }
      }
    },
    "Some authors don't list it. Once a mod is installed, Tadpole looks inside it for Script Extender scripts and marks it too." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains auteurs ne le citent pas. Une fois un mod installé, Tadpole cherche des scripts du Script Extender à l’intérieur et le signale aussi."
          }
        }
      }
    },
    "Some Files Weren't Installed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains fichiers n’ont pas été installés"
          }
        }
      }
    },
    "Sorcerer" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensorceleur"
          }
        }
      }
    },
    "Sort" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trier"
          }
        }
      }
    },
    "Status" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "État"
          }
        }
      }
    },
    "Steam replaced the game's program. Tadpole applies the Script Extender again when you press Play." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam a remplacé le programme du jeu. Tadpole réapplique le Script Extender quand vous appuyez sur Jouer."
          }
        }
      }
    },
    "Steam replaces the game's program when the game updates, which removes the Script Extender. Tadpole notices, and applies it again before you press **Play** (or click **Apply Again** on the Load Order page). **Remove** in Settings puts the game's original program back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam remplace le programme du jeu lors des mises à jour, ce qui retire le Script Extender. Tadpole s’en aperçoit et le réapplique avant que vous appuyiez sur **Jouer** (ou cliquez sur **Réappliquer** dans l’ordre de chargement). **Supprimer** dans les réglages remet le programme d’origine du jeu."
          }
        }
      }
    },
    "Stop" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter"
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système"
          }
        }
      }
    },
    "System (%@)" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système (%@)"
          }
        }
      }
    },
    "Tactician" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tacticien"
          }
        }
      }
    },
    "Tadpole" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole"
          }
        }
      }
    },
    "Tadpole adds the Script Extender to the game's program and keeps the original next to it. Steam replaces the program when the game updates: Tadpole applies the Script Extender again before you press Play, or from the Load Order page. Remove puts the original back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole ajoute le Script Extender au programme du jeu et garde l’original à côté. Steam remplace le programme lors des mises à jour du jeu : Tadpole réapplique le Script Extender avant que vous appuyiez sur Jouer, ou depuis l’ordre de chargement. Supprimer remet l’original."
          }
        }
      }
    },
    "Tadpole can't change the game" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole ne peut pas modifier le jeu"
          }
        }
      }
    },
    "Tadpole Can't Change the Game" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole ne peut pas modifier le jeu"
          }
        }
      }
    },
    "Tadpole catches **Mod Manager Download** links only in its own browser, so it doesn't take them from Starseed or another mod manager in Safari or Chrome." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole ne récupère les liens **Mod Manager Download** que dans son propre navigateur : il ne les prend pas à Starseed ni à un autre gestionnaire de mods dans Safari ou Chrome."
          }
        }
      }
    },
    "Tadpole checks for new releases with your mod updates and lists them on the **Updates** page. Each release is made for a game build: if it isn't yours, Settings says so, and it may run with some features off until a release supports your build." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole cherche les nouvelles versions avec les mises à jour de vos mods et les affiche dans **Mises à jour**. Chaque version est faite pour un build du jeu : si ce n’est pas le vôtre, les réglages le signalent, et il peut tourner avec certaines fonctions désactivées jusqu’à ce qu’une version prenne en charge votre build."
          }
        }
      }
    },
    "Tadpole checks Nexus for new versions of the mods it downloaded, at launch and every 6 hours, and notifies you when it finds some. **Updates** lists them with what changed; **Update** or **Update All** installs them. The old .pak goes to the Trash and the mod keeps its place in the load order." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole cherche sur Nexus de nouvelles versions des mods qu’il a téléchargés, au lancement et toutes les 6 heures, et vous avertit quand il en trouve. **Mises à jour** les liste avec leurs nouveautés ; **Mettre à jour** ou **Tout mettre à jour** les installe. L’ancien .pak va dans la corbeille et le mod garde sa place dans l’ordre de chargement."
          }
        }
      }
    },
    "Tadpole Help" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide de Tadpole"
          }
        }
      }
    },
    "Tadpole installs Baldur's Gate 3 mods and sets the order they load in. It works with the game's own files in **Documents/Larian Studios/Baldur's Gate 3**, so the game's mod list and Tadpole's are always the same." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole installe des mods de Baldur’s Gate 3 et règle l’ordre dans lequel ils se chargent. Il travaille avec les fichiers du jeu lui-même, dans **Documents/Larian Studios/Baldur's Gate 3** : la liste de mods du jeu et celle de Tadpole sont donc toujours les mêmes."
          }
        }
      }
    },
    "Tadpole installs mods packaged as .pak files, which is how most Baldur's Gate 3 mods come. Mods made of loose files that go into the game's own folders, and tools for Windows (.dll, .exe), aren't installed: the download list says so." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole installe les mods fournis en fichiers .pak, la forme de la plupart des mods de Baldur’s Gate 3. Les mods faits de fichiers libres à mettre dans les dossiers du jeu, et les outils pour Windows (.dll, .exe), ne sont pas installés : la liste des téléchargements le signale."
          }
        }
      }
    },
    "Tadpole knows which Nexus mod an installed mod comes from when it was downloaded through Tadpole. For mods you installed from files, select the mod and click **Find on Nexus…** in its details: once linked, it counts as installed in collections." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole sait de quel mod Nexus vient un mod installé quand il a été téléchargé par Tadpole. Pour les mods installés depuis des fichiers, sélectionnez le mod et cliquez sur **Trouver sur Nexus…** dans ses détails : une fois lié, il compte comme installé dans les collections."
          }
        }
      }
    },
    "Tadpole manages the mods in “Documents/Larian Studios/Baldur's Gate 3”. The game creates that folder the first time it runs: start it, reach the main menu, quit, then come back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole gère les mods dans « Documents/Larian Studios/Baldur’s Gate 3 ». Le jeu crée ce dossier à son premier lancement : lancez-le, allez jusqu’au menu principal, quittez, puis revenez."
          }
        }
      }
    },
    "Tadpole marks those mods with a **Script Extender** badge. Mods that only change looks, items, hair, dice or text don't need it and work normally." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tadpole marque ces mods d’un badge **Script Extender**. Les mods qui changent seulement l’apparence, des objets, des coiffures, des dés ou du texte n’en ont pas besoin et marchent normalement."
          }
        }
      }
    },
    "Tadpole Release Notes" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes de version de Tadpole"
          }
        }
      }
    },
    "Tadpole Updates" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mises à jour de Tadpole"
          }
        }
      }
    },
    "Take it out of the load order" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retirer de l’ordre de chargement"
          }
        }
      }
    },
    "The bar at the bottom" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre du bas"
          }
        }
      }
    },
    "The bar at the bottom of the window shows the game's version and the Script Extender's: green when all is well, yellow when it needs something (an update, applying again after a game update, or a release made for another game build), with a button to do it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre en bas de la fenêtre affiche la version du jeu et celle du Script Extender : vert quand tout va bien, jaune quand il faut faire quelque chose (une mise à jour, le réappliquer après une mise à jour du jeu, ou une version faite pour un autre build du jeu), avec un bouton pour le faire."
          }
        }
      }
    },
    "The download and install go on in the main window's sidebar. With several mods to download, the browser stays open until the last one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement et l’installation continuent dans la barre latérale de la fenêtre principale. Avec plusieurs mods à télécharger, le navigateur reste ouvert jusqu’au dernier."
          }
        }
      }
    },
    "The game can remove mods it can't load from its list. Open **Load Order**, tick them again, and check their requirements. The previous file is kept as **modsettings.lsx.bak** (**Settings → Game** shows where)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu peut retirer de sa liste les mods qu’il n’arrive pas à charger. Ouvrez **Ordre de chargement**, cochez-les de nouveau et vérifiez leurs prérequis. Le fichier précédent est gardé sous le nom **modsettings.lsx.bak** (**Réglages → Jeu** indique où)."
          }
        }
      }
    },
    "The game decides where these are; Tadpole works with them where they are. Each change to the load order keeps the previous file as modsettings.lsx.bak." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est le jeu qui décide de leur emplacement ; Tadpole travaille avec eux là où ils sont. Chaque changement de l’ordre de chargement garde le fichier précédent sous le nom modsettings.lsx.bak."
          }
        }
      }
    },
    "The game is running: Tadpole won't change the load order until you quit it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu est lancé : Tadpole ne changera pas l’ordre de chargement tant que vous ne l’aurez pas quitté."
          }
        }
      }
    },
    "The game loads only one copy of a mod, and it may not be the newest one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu ne charge qu’une copie d’un mod, et ce n’est peut-être pas la plus récente."
          }
        }
      }
    },
    "The game loads the mods listed in its load order file, from top to bottom, after its own modules. A mod in the Mods folder that isn't listed doesn't load." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu charge les mods listés dans son fichier d’ordre de chargement, de haut en bas, après ses propres modules. Un mod du dossier Mods qui n’y est pas listé n’est pas chargé."
          }
        }
      }
    },
    "The game reset my mods" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu a réinitialisé mes mods"
          }
        }
      }
    },
    "The game rewrites its mod list when it quits, which would undo this change." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu réécrit sa liste de mods en quittant, ce qui annulerait ce changement."
          }
        }
      }
    },
    "The game was updated" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu a été mis à jour"
          }
        }
      }
    },
    "The game's original program is put back. Script Extender mods stay installed, but their scripted features stop working." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme d’origine du jeu est remis en place. Les mods Script Extender restent installés, mais leurs fonctions scriptées cessent de marcher."
          }
        }
      }
    },
    "The game's version, from Steam." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version du jeu, d’après Steam."
          }
        }
      }
    },
    "The Load Order" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordre de chargement"
          }
        }
      }
    },
    "The log" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal"
          }
        }
      }
    },
    "The macOS version" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version macOS"
          }
        }
      }
    },
    "The menu bar icon" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’icône de la barre des menus"
          }
        }
      }
    },
    "The new language applies after a restart." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle langue s’applique après un redémarrage."
          }
        }
      }
    },
    "The pages" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages"
          }
        }
      }
    },
    "The Script Extender also listed %@ as Script Extender mods, by mistake: it matched them to the scripts of %@. They don't use the Script Extender and aren't counted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Script Extender also listed %1$@ as Script Extender mods, by mistake: it matched them to the scripts of %2$@. They don't use the Script Extender and aren't counted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Script Extender a aussi listé %@ comme mods Script Extender, par erreur : il les a associés aux scripts de %@. Ils n’utilisent pas le Script Extender et ne sont pas comptés."
          }
        }
      }
    },
    "The Script Extender is installed into the game, which can't be changed while it runs." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Script Extender s’installe dans le jeu, qui ne peut pas être modifié pendant qu’il tourne."
          }
        }
      }
    },
    "The Script Extender is installed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Script Extender est installé."
          }
        }
      }
    },
    "The Script Extender writes a log each time the game runs with it, like SMAPI's for Stardew Valley: which mods it loaded and what went wrong. Install it in Settings first." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Script Extender écrit un journal chaque fois que le jeu tourne avec lui, comme celui de SMAPI pour Stardew Valley : les mods qu’il a chargés et ce qui a échoué. Installez-le d’abord dans les réglages."
          }
        }
      }
    },
    "The tadpole in the menu bar shows the game's version, how many mods load, and the number of mod updates. From it you can play, update your mods, and back up your saves. While it's shown, closing the window keeps Tadpole running so it can keep checking for updates: quit from its menu. Turn it off in **Settings → General**." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le têtard dans la barre des menus affiche la version du jeu, le nombre de mods chargés et le nombre de mises à jour. Depuis son menu, vous pouvez jouer, mettre à jour vos mods et sauvegarder vos parties. Tant qu’il est affiché, fermer la fenêtre laisse Tadpole ouvert pour qu’il continue à vérifier les mises à jour : quittez depuis son menu. Désactivez-le dans **Réglages → Général**."
          }
        }
      }
    },
    "The update removed the Script Extender. Tadpole applies it again when you press Play, or now." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour a retiré le Script Extender. Tadpole le réapplique quand vous appuyez sur Jouer, ou maintenant."
          }
        }
      }
    },
    "Theme" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thème"
          }
        }
      }
    },
    "Then click **Mod Manager Download** on a mod's Files tab: Tadpole downloads and installs it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, cliquez sur **Mod Manager Download** dans l’onglet Files d’un mod : Tadpole le télécharge et l’installe."
          }
        }
      }
    },
    "This link is for “%@”. Only Baldur's Gate 3 mods can be installed here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien est pour « %@ ». Seuls les mods de Baldur’s Gate 3 peuvent être installés ici."
          }
        }
      }
    },
    "This mod is in the load order. Quit the game before removing it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mod est dans l’ordre de chargement. Quittez le jeu avant de le supprimer."
          }
        }
      }
    },
    "This mod uses Norbyte's Script Extender, which isn't available on macOS. Its scripted features won't work." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mod utilise le Script Extender de Norbyte, qui n’existe pas sur macOS. Ses fonctions scriptées ne marcheront pas."
          }
        }
      }
    },
    "This mod uses Norbyte's Script Extender, which isn't installed. Its scripted features won't work: install the macOS version in Settings → Script Extender." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mod utilise le Script Extender de Norbyte, qui n’est pas installé. Ses fonctions scriptées ne marcheront pas : installez la version macOS dans Réglages → Script Extender."
          }
        }
      }
    },
    "This mod uses the Script Extender, which is installed. Its scripted features work as far as the macOS version supports them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mod utilise le Script Extender, qui est installé. Ses fonctions scriptées marchent dans la mesure où la version macOS les prend en charge."
          }
        }
      }
    },
    "This release was made for game build %@, not %@: some features are off until a release supports it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This release was made for game build %1$@, not %2$@: some features are off until a release supports it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version a été faite pour le build du jeu %@, pas %@ : certaines fonctions sont désactivées jusqu’à ce qu’une version le prenne en charge."
          }
        }
      }
    },
    "This save is still in the game. Restoring puts the backed-up version in its place; the current one goes to the Trash." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde est toujours dans le jeu. La restauration met la copie à sa place ; l’actuelle va dans la corbeille."
          }
        }
      }
    },
    "Tick a mod to add it to the end of the load order; untick it to take it out. It stays installed either way, under **Installed, Not Loaded**. Drag mods to change their order." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cochez un mod pour l’ajouter à la fin de l’ordre de chargement ; décochez-le pour l’en retirer. Il reste installé dans les deux cas, sous **Installés, non chargés**. Faites glisser les mods pour changer leur ordre."
          }
        }
      }
    },
    "To download from Nexus Mods inside Tadpole, add your personal API key in **Settings → Nexus Mods** (⌘,)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour télécharger depuis Nexus Mods dans Tadpole, ajoutez votre clé d’API personnelle dans **Réglages → Nexus Mods** (⌘,)."
          }
        }
      }
    },
    "Troubleshooting" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépannage"
          }
        }
      }
    },
    "Try Again" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayer"
          }
        }
      }
    },
    "Turn this mod on to check" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez ce mod pour vérifier"
          }
        }
      }
    },
    "Turned off: %@. Mods that use these won't fully work until a release supports your build." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : %@. Les mods qui s’en servent ne marcheront pas complètement tant qu’une version ne prendra pas en charge votre build."
          }
        }
      }
    },
    "Turning mods on and off" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer et désactiver des mods"
          }
        }
      }
    },
    "Turns on when the game quits" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’active quand le jeu se ferme"
          }
        }
      }
    },
    "Unlink" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délier"
          }
        }
      }
    },
    "Unsupported Link" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lien non pris en charge"
          }
        }
      }
    },
    "Update" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre à jour"
          }
        }
      }
    },
    "Update All" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout mettre à jour"
          }
        }
      }
    },
    "Update All (%lld)" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout mettre à jour (%lld)"
          }
        }
      }
    },
    "Update it from the Updates page." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez-le à jour depuis la page Mises à jour."
          }
        }
      }
    },
    "Update to %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer à %@"
          }
        }
      }
    },
    "Updates" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mises à jour"
          }
        }
      }
    },
    "Updates show what's new before they install. They're checked against Tadpole's own signing key." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour montrent les nouveautés avant de s’installer. Elles sont vérifiées avec la clé de signature propre à Tadpole."
          }
        }
      }
    },
    "Uses Norbyte's Script Extender, which isn't installed. Its scripted features won't work; parts that don't need it may still work. Install the macOS version in Settings → Script Extender." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le Script Extender de Norbyte, qui n’est pas installé. Ses fonctions scriptées ne marcheront pas ; les parties qui n’en ont pas besoin peuvent marcher. Installez la version macOS dans Réglages → Script Extender."
          }
        }
      }
    },
    "Uses the Script Extender, which is installed. Its scripted features work as far as the macOS version supports them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le Script Extender, qui est installé. Ses fonctions scriptées marchent dans la mesure où la version macOS les prend en charge."
          }
        }
      }
    },
    "UUID" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UUID"
          }
        }
      }
    },
    "Version" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version"
          }
        }
      }
    },
    "Version %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@"
          }
        }
      }
    },
    "Version %@ available" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@ disponible"
          }
        }
      }
    },
    "Version %@ installed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@ installée"
          }
        }
      }
    },
    "Version %@ is available." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version %@ est disponible."
          }
        }
      }
    },
    "Version %@ was made for game build %@, not yours. It may run in a limited mode, with some features off, until a release supports your build." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Version %1$@ was made for game build %2$@, not yours. It may run in a limited mode, with some features off, until a release supports your build."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version %@ a été faite pour le build du jeu %@, pas le vôtre. Elle peut tourner en mode limité, avec certaines fonctions désactivées, jusqu’à ce qu’une version prenne en charge votre build."
          }
        }
      }
    },
    "View on Nexus Mods" : {
      "localizations" : {
